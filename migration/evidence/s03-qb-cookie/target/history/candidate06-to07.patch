+	if err != nil {
+		t.Fatal(err)
+	}
+	rows := value.(map[string]any)["versions"].([]any)
+	if len(rows) != 23 {
+		t.Fatalf("versions=%d", len(rows))
+	}
+	for _, item := range rows {
