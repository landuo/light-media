+// forwarding, environment rewrite, UID discovery or production App startup.
+func originalRequestUtilsOwnedTLS(t *testing.T, handler http.Handler) *httptest.Server {
+	t.Helper()
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
