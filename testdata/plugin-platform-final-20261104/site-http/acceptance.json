  "contracts": {
    "sites.request": "current configured site, GET/POST; ordered/repeated form/query, explicit JSON/raw bytes, source header defaults/referer, current cookie/UA/proxy/optional raw credential header binding; private response bytes/ContentType/cookie dictionary. POST completed/unknown outcome survives post-request scope change. No automatic POST replay.",
    "sites.credentials": "exact configured site ID/current real worker scope returns typed Cookie/UA/APIKey/Token privately in IPC/memory for trusted Go code; no implicit public route/config/log/DB projection. Fresh real stop_service cleanup grant remains valid; revoked old ordinary calls denied. Not an OS/network sandbox.",
    "response_cookies": "private ordered name/value dictionary; nil CookieOverride uses configured cookie, pointer to empty pairs sends no cookie, nonempty replaces. Fixed Response-cookie8 source filtering retained; no new handle/session framework.",
    "USER_AGENT": "readonly SystemSettings.Get USER_AGENT; UseHostUserAgent explicit mutual exclusion withUseSiteUserAgent; source caller suffix only default headers using global service UA, exact configured ordinary browserUA unchanged, custom headers can keep global agent withoutsuffix"
  },
  "necessary_adaptations": [
    {
      "source": "raw Python class/requests.Response and calls read fields directly",
      "Go": "finite explicit typed private IPC; optional string DB null maps host native empty-string fields. Known actual callers use falsey/or-empty semantics. Normal Go handles arbitrary own-memory calculations, not a host template/signature framework."
    },
    {
      "source": "RequestUtils defaults verify=False and may follow crossorigin or derived API hosts",
      "Go": "existing configured canonical source and TLS validation retained on every outward hop; existing MTeam canonical API normalization is used, no credential forwarding exception/global TLS override."
    },
    {
      "source": "Python library temporary Session/JSON objects",
      "Go": "host reuses existing Requests proxy merge/inactivity timeout/content decode; precise fixed-source6 request wires,8 cookie cases,4 globalUA cases compared. Source arbitrary class identity/exceptions replaced with typed JSON and sanitized Go failure codes."
    },
    {
      "source": "RequestException→None even after an external write",
      "Go": "Response nil plus request_state unknown; after recognized POST outcome and stale config, scope_changed preserves completed/unknown factual result. No durable jobs, replay, workflow/action/session engine added."
    },
    {
      "source": "full arbitrary response headers/url used by some plugins on their own URLs",
      "Go": "only actual site-call needed ContentType plus decoded bytes/cookies exposed; source installed77 metadata static+dynamic inventory separates own-URL Server/Date/raw.version probes that use ordinary Go networking."
    }
  ],
  "intermediate_failures": [
    "sdk-normal.jsonl retained: Go synthesized Referer on302/307; fixed explicit originalReferer only before final6 wire pass",
    "sdk-normal-r3.jsonl retained: assertion incorrectly treated existing editable/public UA as password; narrowed to actual sensitive Cookie/APIKey/Token, public UA editor unchanged",
    "older opaque cookie/transform development variants were never accepted; removed in final trusted private IPC contract, prior logs retained as historical variants"
  ],
