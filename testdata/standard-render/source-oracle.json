  "cases": [
    {
      "name": "model-aliases-and-updates",
      "kind": "props",
      "model": {
        "text": "start",
        "count": 2,
        "choice": "A"
      },
      "props": {
        "modelvalue": "text",
        "v-model": "count",
        "model:selection": "choice",
        "label": "text"
      },
      "updates": [
        {
          "handler": "onUpdate:value",
          "value": "changed"
        },
        {
          "handler": "onUpdate:modelValue",
          "value": 4
        },
        {
          "handler": "onUpdate:selection",
          "value": "B"
        }
      ],
      "expected": {
        "props": {
          "value": "start",
          "onUpdate:value": "$function",
          "modelValue": 2,
          "onUpdate:modelValue": "$function",
          "selection": "A",
          "onUpdate:selection": "$function",
          "label": "start"
        },
        "model": {
          "text": "changed",
          "count": 4,
          "choice": "B"
        }
      }
    },
    {
      "name": "literal-unicode-and-punctuation-keys",
      "kind": "props",
      "model": {
        "7": "seven",
        "中文 标题": "原值",
        "custom[password]": "brackets",
        "custom.constructor": "literal dotted",
        "null": "nullable"
      },
      "props": {
        "model": "中文 标题",
        "model:selection:ignored": "custom[password]",
        "label": "custom.constructor",
        "modelvalue": 7,
        "model:nullable": null
      },
      "updates": [
        {
          "handler": "onUpdate:modelValue",
          "value": "新值"
        },
        {
          "handler": "onUpdate:selection",
          "value": "edited"
        },
        {
          "handler": "onUpdate:value",
          "value": "seven edited"
        },
        {
          "handler": "onUpdate:nullable",
          "value": "null edited"
        }
      ],
      "expected": {
        "props": {
          "modelValue": "原值",
          "onUpdate:modelValue": "$function",
          "selection": "brackets",
          "onUpdate:selection": "$function",
          "label": "literal dotted",
          "value": "seven",
          "onUpdate:value": "$function",
          "nullable": "nullable",
          "onUpdate:nullable": "$function"
        },
        "model": {
          "7": "seven edited",
          "中文 标题": "新值",
          "custom[password]": "edited",
          "custom.constructor": "literal dotted",
          "null": "null edited"
        }
      }
