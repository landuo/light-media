        "slots": {
          "append": {
            "component": "span",
            "props": {},
            "content": "suffix"
          },
          "prepend": [
            {
              "component": "b",
              "props": {},
              "content": "prefix"
            }
          ],
          "default": [
            {
              "component": "span",
              "props": {},
              "content": "default content"
            }
          ]
        }
      }
