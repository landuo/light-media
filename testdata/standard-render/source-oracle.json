    {
      "name": "native-style-keeps-css-props-and-complex-author-rules",
      "kind": "render",
      "model": {},
      "node": {
        "component": "style",
        "props": {
          "media": "screen"
        },
        "text": "/* owned */ @media (min-width:300px) { .owned > b:is(.probe) { --owned:red; transform:translateX(3px); color:var(--owned); padding-block:5px } }"
      },
      "expected": {
        "component": "style",
        "props": {
          "media": "screen"
        },
        "content": "/* owned */ @media (min-width:300px) { .owned > b:is(.probe) { --owned:red; transform:translateX(3px); color:var(--owned); padding-block:5px } }"
      }
    },
