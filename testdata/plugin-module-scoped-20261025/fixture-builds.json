    },
    {
      "env": "OWNED_STANDARD_DASHBOARD_TWO_FIXTURE_BINARY",
      "command": "./cmd/owned-standard-fixture",
      "ldflags": "-X main.fixtureDashboardParameters=[\"key\",\"user_agent\"]"
    },
    {
      "env": "OWNED_STANDARD_DASHBOARD_INVALID_FIXTURE_BINARY",
      "command": "./cmd/owned-standard-fixture",
      "ldflags": "-X main.fixtureDashboardParameters=[\"key\"]"
    }
  ],
  "linux_process_additions": [
    {
      "command": "./cmd/owned-standard-fixture",
      "v1_flags": "-X main.fixturePageEvents=true -X main.fixturePageDelay=true",
      "v2_flags": "-X main.fixturePageEvents=true -X main.fixtureVersion=2.0"
    }
  ],
  "environment": {
    "GOOS": "linux",
    "GOARCH": "amd64",
    "CGO_ENABLED": "0"
  },
  "note": "build in primary Git worktree with default caches; artifacts cleaned after evidence retention; no Python application runtime"
}
