{
  "name": "light-media-web",
  "version": "0.3.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "check": "vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "format": "prettier --write src tests vite.config.ts",
    "format:check": "prettier --check src tests vite.config.ts"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
