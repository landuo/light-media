{
  "name": "light-media-web",
  "version": "0.4.19",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-icons.mjs && node scripts/build-plugin-utilities.mjs && vue-tsc --noEmit && vite build && node scripts/precompress.mjs",
    "check": "node scripts/build-icons.mjs && node scripts/build-plugin-utilities.mjs && vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "format": "prettier --write src tests scripts vite.config.ts",
    "format:check": "prettier --check src tests scripts vite.config.ts"
  },
  "dependencies": {
    "@iconify/vue": "4.3.0",
    "@vue-js-cron/vuetify": "5.0.9",
    "ace-builds": "1.37.4",
    "apexcharts": "4.7.0",
    "axios": "1.9.0",
    "colorthief": "2.6.0",
    "dayjs": "1.11.13",
    "gridstack": "12.6.0",
    "markdown-it": "14.1.0",
    "markdown-it-link-attributes": "4.0.1",
    "vue": "3.5.44",
    "vue3-ace-editor": "2.2.4",
    "vue3-apexcharts": "1.8.0",
    "vuedraggable": "4.1.0",
    "vuetify": "3.7.3"
  },
  "devDependencies": {
    "@iconify-json/mdi": "1.2.3",
    "@types/markdown-it": "14.1.2",
    "@types/markdown-it-link-attributes": "3.0.5",
    "@vitejs/plugin-vue": "6.0.10",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
